#cloud-config
autoinstall:
  version: 1
  apt:
    geoip: true
    preserve_sources_list: false
    primary:
      - arches: [amd64]
        uri: https://repo.huaweicloud.com/ubuntu
      - arches: [default]
        uri: http://ports.ubuntu.com/ubuntu-ports

  identity:
    hostname: ubuntu-server
    username: ubuntu
    password: "$6$j/6FKaGvOBawk54n$18J/U3APCJw5f/QiKGS/WPiCIVVbSz5tQ5gx8EODUfypNR.zjzYKLRtjfDOgLpd/W43zuHVioqELQOmEa34og1"

  storage:
    config:
      - ptable: gpt
        path: /dev/sda
        wipe: superblock
        preserve: false
        grub_device: true
        type: disk
        id: disk-sda

      # EFI 鍒嗗尯锛�512M锛夛紝鐢ㄤ簬 UEFI
      - device: disk-sda
        size: 536870912    # 512M
        flag: esp
        number: 1
        preserve: false
        grub_device: true
        type: partition
        id: partition-efi

      - fstype: fat32
        volume: partition-efi
        preserve: false
        type: format
        id: format-efi

      # /boot 鍒嗗尯锛�4G锛夛紝鐢ㄤ簬鍐呮牳
      - device: disk-sda
        size: 4294967296   # 4G
        flag: ''
        number: 2
        preserve: false
        grub_device: false
        type: partition
        id: partition-boot

      - fstype: ext4
        volume: partition-boot
        preserve: false
        type: format
        id: format-boot

      # 鏍瑰垎鍖猴紙鍓╀綑绌洪棿锛宔xt4锛�
      - device: disk-sda
        size: -1
        flag: ''
        number: 3
        preserve: false
        grub_device: false
        type: partition
        id: partition-root

      - fstype: ext4
        volume: partition-root
        preserve: false
        type: format
        id: format-root

      # 鎸傝浇鐐�
      - path: /boot/efi
        device: format-efi
        type: mount
        id: mount-efi

      - path: /boot
        device: format-boot
        type: mount
        id: mount-boot

      - path: /
        device: format-root
        type: mount
        id: mount-root

  ssh:
    install-server: true
    allow-pw: true
  locale: en_US.UTF-8
  keyboard:
    layout: us
    variant: ''
  user-data:
    timezone: Asia/Shanghai
    package_update: false
    package_upgrade: false
    write_files:
      - path: /etc/sudoers.d/nopasswd
        owner: root:root
        permissions: '0440'
        content: |
          %sudo ALL=(ALL) NOPASSWD:ALL

  late-commands:
    - mkdir -p /target/opt
    - cp -a /cdrom/extras /target/opt/
    - curtin in-target --target=/target -- mkdir -p /home/ubuntu/.ssh
    - curtin in-target --target=/target -- chmod 700 /home/ubuntu/.ssh
    - test -s /cdrom/extras/keys/authorized_keys && cp /cdrom/extras/keys/authorized_keys /target/home/ubuntu/.ssh/authorized_keys || true
    - test -s /target/home/ubuntu/.ssh/authorized_keys && curtin in-target --target=/target -- chown -R 1000:1000 /home/ubuntu/.ssh || true
    - test -s /target/home/ubuntu/.ssh/authorized_keys && curtin in-target --target=/target -- chmod 600 /home/ubuntu/.ssh/authorized_keys || true
    - curtin in-target --target=/target -- chmod +x /opt/extras/scripts/*.sh
    - curtin in-target --target=/target -- bash /opt/extras/scripts/post-install.sh
