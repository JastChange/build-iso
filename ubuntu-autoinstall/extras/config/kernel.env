# 固定内核版本安装配置
# 留空则跳过内核版本锁定逻辑。

# 目标 ABI 版本。留空则跳过固定内核安装。
# 支持以下两种写法：
# - 5.15.0-164
# - 5.15.0-164-generic
KERNEL_VERSION=""

# 内核 flavor。通常保持 generic。
KERNEL_FLAVOR="generic"

# 安装模式：
# - deb:  从 /opt/extras/debs 中直接安装匹配的内核 deb 包
# - repo: 从 /opt/extras/repo 本地离线仓库安装
# - auto: repo 优先，repo 不可用时回退到 deb，再不行才回退到系统 APT 源
# 当 KERNEL_VERSION 为空时，此项不会生效。
INSTALL_MODE="auto"

# 安装后是否锁定指定内核版本，避免被后续升级覆盖
KERNEL_HOLD="true"
