# 首次开机任务配置

# 驱动首次开机安装完成后是否自动重启服务器。
FIRSTBOOT_REBOOT="true"

# 完成后是否删除 /opt/extras 中的驱动包、离线仓库和脚本等残留文件。
CLEANUP_EXTRAS="true"

# 驱动安装失败时的策略：
# - continue: 记录失败并继续尝试后续驱动，但最终验收不会放行清理/重启
# - fail:     当前驱动失败后停止后续驱动安装，保留现场供排查
DRIVER_FAILURE_POLICY="continue"

# 是否启用首次开机调试日志。启用后会写入 shell trace、系统快照和安装器输出。
FIRSTBOOT_DEBUG="false"

# 驱动安装是否强制离线。true 时首次开机阶段不会执行 apt-get update/install；
# 如缺少依赖会直接失败并在日志中列出缺失包，需要把依赖加入 packages.list 后重新构建 ISO。
DRIVER_OFFLINE_MODE="true"

# 调试日志目录。
DEBUG_DIR="/var/log/ubuntu-autoinstall-debug"

# Mellanox OFED 安装范围：
# - basic: 基础网卡/RDMA 功能，默认推荐
# - hpc/all/dpdk/ovs-dpdk/vma/xlio/guest/hypervisor/bluefield: 透传给 mlnxofedinstall
# - none: 不传 profile 参数，使用厂商安装器默认选择
MLNX_INSTALL_PROFILE="basic"

# 兼容旧配置。当前版本由最终验收脚本统一控制：验收未通过时始终保留 /opt/extras。
RETAIN_ON_DRIVER_FAILURE="true"

# 兼容旧配置。当前版本由最终验收脚本统一控制：验收未通过时不会自动重启。
REBOOT_ON_DRIVER_FAILURE="false"

# 驱动失败时是否仍写入 firstboot.done。调试阶段建议保持 false，便于排查后重跑。
MARK_DONE_ON_DRIVER_FAILURE="false"

# 兼容旧配置。当前版本由最终验收脚本统一控制：验收未通过时始终保留 iso-firstboot.service。
KEEP_SERVICE_ON_DRIVER_FAILURE="true"

# 是否执行最终安装验收脚本。只有验收脚本返回 0，firstboot 才会清理 /opt/extras 并按策略重启。
FINAL_VERIFY_ENABLED="true"

# 最终安装验收脚本路径。
FINAL_VERIFY_SCRIPT="/opt/extras/scripts/verify-install.sh"
